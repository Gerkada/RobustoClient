<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>RobustoClient</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2024.2.0" />
        <PackageReference Include="Lib.Harmony" Version="2.3.6" />
        <PackageReference Include="Hexa.NET.ImGui" Version="2.2.9" PrivateAssets="all" GeneratePathProperty="true" />
        <PackageReference Include="HexaGen.Runtime" Version="1.1.21" PrivateAssets="all" GeneratePathProperty="true" />
    </ItemGroup>

    <Target Name="EmbedImGuiBinaries" BeforeTargets="SplitResourcesByCulture;PrepareResources">
        <ItemGroup>
            <EmbeddedResource Include="$(PkgHexa_NET_ImGui)/lib/net9.0/Hexa.NET.ImGui.dll"
                              LogicalName="RobustoClient.Embedded.Hexa.NET.ImGui.dll" />
            <EmbeddedResource Include="$(PkgHexaGen_Runtime)/lib/net9.0/HexaGen.Runtime.dll"
                              LogicalName="RobustoClient.Embedded.HexaGen.Runtime.dll" />
            <EmbeddedResource Include="$(PkgHexa_NET_ImGui)/runtimes/win-x64/native/cimgui.dll"
                              LogicalName="RobustoClient.Embedded.win-x64.cimgui.dll"
                              Condition="Exists('$(PkgHexa_NET_ImGui)/runtimes/win-x64/native/cimgui.dll')" />
            <EmbeddedResource Include="$(PkgHexa_NET_ImGui)/runtimes/linux-x64/native/cimgui.so"
                              LogicalName="RobustoClient.Embedded.linux-x64.cimgui.so"
                              Condition="Exists('$(PkgHexa_NET_ImGui)/runtimes/linux-x64/native/cimgui.so')" />
            <EmbeddedResource Include="$(PkgHexa_NET_ImGui)/runtimes/osx-x64/native/cimgui.dylib"
                              LogicalName="RobustoClient.Embedded.osx-x64.cimgui.dylib"
                              Condition="Exists('$(PkgHexa_NET_ImGui)/runtimes/osx-x64/native/cimgui.dylib')" />
            <EmbeddedResource Include="$(PkgHexa_NET_ImGui)/runtimes/osx-arm64/native/cimgui.dylib"
                              LogicalName="RobustoClient.Embedded.osx-arm64.cimgui.dylib"
                              Condition="Exists('$(PkgHexa_NET_ImGui)/runtimes/osx-arm64.cimgui.dylib')" />
        </ItemGroup>
    </Target>

    <ItemGroup> 
        <ProjectReference Include="..\space-station-14\Content.Client\Content.Client.csproj">
            <Name>Content.Client</Name>
            <Private>False</Private>
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
        <ProjectReference Include="..\space-station-14\Content.Shared\Content.Shared.csproj">
            <Name>Content.Shared</Name>
            <Private>False</Private>
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
        <ProjectReference Include="..\space-station-14\RobustToolbox\Robust.Shared\Robust.Shared.csproj">
            <Name>Robust.Shared</Name>
            <Private>False</Private>
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
        <ProjectReference Include="..\space-station-14\RobustToolbox\Robust.Client\Robust.Client.csproj">
            <Name>Robust.Client</Name>
            <Private>False</Private>
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
        <ProjectReference Include="..\space-station-14\RobustToolbox\Robust.Shared.Maths\Robust.Shared.Maths.csproj">
            <Name>Robust.Shared.Maths</Name>
            <Private>False</Private>
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
        <ProjectReference Include="..\space-station-14\RobustToolbox\Robust.Shared.Scripting\Robust.Shared.Scripting.csproj">
            <Name>Robust.Shared.Scripting</Name>
            <Private>False</Private>
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
        <ProjectReference Include="..\space-station-14\Content.Shared.Database\Content.Shared.Database.csproj">
            <Name>Content.Shared.Database</Name>
            <Private>False</Private>
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
        <ProjectReference Include="..\space-station-14\RobustToolbox\NetSerializer\NetSerializer\NetSerializer.csproj"
                          Condition="Exists('..\space-station-14\RobustToolbox\NetSerializer\NetSerializer\NetSerializer.csproj')">
            <Name>Robust.NetSerializer</Name>
            <Private>False</Private>
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
        <ProjectReference Include="..\space-station-14\RobustToolbox\Lidgren.Network\Lidgren.Network.csproj">
            <Name>Lidgren.Network</Name>
            <Private>False</Private>
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
        <ProjectReference Include="..\space-station-14\RobustToolbox\Avalonia.Base\Avalonia.Base.csproj"
                          Condition="Exists('..\space-station-14\RobustToolbox\Avalonia.Base\Avalonia.Base.csproj')">
            <Name>Avalonia.Base</Name>
            <Private>False</Private>
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
        <ProjectReference Include="..\space-station-14\RobustToolbox\Robust.LoaderApi\Robust.LoaderApi\Robust.LoaderApi.csproj">
            <Name>Robust.LoaderApi</Name>
            <Private>False</Private>
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
        <ProjectReference Include="..\space-station-14\RobustToolbox\OpenToolkit.GraphicsLibraryFramework\OpenToolkit.GraphicsLibraryFramework.csproj"
                          Condition="Exists('..\space-station-14\RobustToolbox\OpenToolkit.GraphicsLibraryFramework\OpenToolkit.GraphicsLibraryFramework.csproj')">
            <Name>OpenToolkit.GraphicsLibraryFramework</Name>
            <Private>False</Private>
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
    </ItemGroup>
</Project>
