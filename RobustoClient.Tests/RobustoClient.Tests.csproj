<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <NoWarn>$(NoWarn);NU1902;NU1903;NU1510</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
        <PackageReference Include="xunit" Version="2.9.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="FluentAssertions" Version="6.12.2" />
        <PackageReference Include="Hexa.NET.ImGui" Version="2.2.9" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\RobustoClient\RobustoClient.csproj" />
        <ProjectReference Include="..\space-station-14\Content.Client\Content.Client.csproj" />
        <ProjectReference Include="..\space-station-14\Content.Shared\Content.Shared.csproj" />
        <ProjectReference Include="..\space-station-14\RobustToolbox\Robust.Shared\Robust.Shared.csproj" />
        <ProjectReference Include="..\space-station-14\RobustToolbox\Robust.Client\Robust.Client.csproj" />
        <ProjectReference Include="..\space-station-14\RobustToolbox\Robust.Shared.Maths\Robust.Shared.Maths.csproj" />
    </ItemGroup>
</Project>
